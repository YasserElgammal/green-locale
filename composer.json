{
    "name": "yasser-elgammal/green-locale",
    "description": "Localized model attributes for Green Framework Web & API.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "YasserElgammal\\GreenLocale\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "YasserElgammal\\GreenLocale\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "yasser-elgammal/green-core": "^2.0",
        "doctrine/dbal": "^4.0",
        "respect/validation": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}